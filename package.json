{
  "name": "ooh-citation-first-benchmark",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "OOH citation-first benchmark: public corpus, public dev, private test questions and labels separated.",
  "scripts": {
    "ooh:dev": "DEV=1 node bench/ooh-aggregate-spike.mjs",
    "ooh:dev:pages": "DEV=1 PAGES=1 node bench/ooh-aggregate-spike.mjs",
    "ooh:test": "node --test kit/test/answer/aggregate.test.mjs kit/test/cli/aggregate.test.mjs && python3 bench/ooh-score.test.py",
    "kit:test": "node kit/bin/test.mjs",
    "ooh:smoke": "npm run ooh:test && npm run kit:test && npm run ooh:dev && npm run ooh:dev:pages",
    "arm:fake": "node bench/arm-compare.mjs --fake",
    "arm:test": "node --test bench/arm-score.test.mjs bench/test/cite-score.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Raulvv/verification-harness.git"
  },
  "homepage": "https://github.com/Raulvv/verification-harness"
}
