{
  "name": "ooh-citation-first-benchmark",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "description": "OOH citation-first benchmark: public corpus, public dev, private test questions and labels separated.",
  "scripts": {
    "ooh:dev": "node bench/ooh-aggregate-spike.mjs",
    "ooh:dev:pages": "PAGES=1 node bench/ooh-aggregate-spike.mjs",
    "ooh:test": "node --test kit/test/answer/aggregate.test.mjs kit/test/cli/aggregate.test.mjs && python3 bench/ooh-score.test.py",
    "kit:test": "node kit/bin/test.mjs"
  }
}
