    "retrieval-manifest-check": "bin/manifest-check.mjs",
    "retrieval-score": "bin/score.mjs",
    "retrieval-sync": "bin/sync.mjs",
    "retrieval-verify": "bin/verify.mjs",
    "retrieval-test": "bin/test.mjs",
    "retrieval-coverage": "bin/coverage.mjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": ["index.mjs", "bin", "lib", "GOLDEN.md", "HISTORY.md", "README.md", "LICENSE", "CHANGELOG.md"],
